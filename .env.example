# 複製這個檔案為 .env 並依需要調整（本機開發用，.env 不會被 commit）。
# 若不設定，application.yml 會使用與 docker-compose.yml 一致的預設值。

DB_URL=jdbc:postgresql://localhost:5432/tradebeyond
DB_USERNAME=admin
DB_PASSWORD=123456

# JWT 簽章密鑰：沒有預設值，本機開發也必須自行提供一組隨機字串。
JWT_SECRET=please-change-me-to-a-random-secret

# 對應 docker-compose.yml 內 postgres 服務的環境變數
POSTGRES_DB=tradebeyond
POSTGRES_USER=admin
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432
